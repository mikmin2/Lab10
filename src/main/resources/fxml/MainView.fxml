<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxml.MainViewController">
   <children>
      <MenuBar layoutY="2.0" prefHeight="25.0" prefWidth="600.0">
        <menus>
          <Menu text="_File">
            <items>
              <MenuItem id="newItem" mnemonicParsing="false" text="New" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem id="openItem" mnemonicParsing="false" text="Open..." />
                  <MenuItem id="closeItem" mnemonicParsing="false" text="Close" />
                  <MenuItem id="saveItem" mnemonicParsing="false" text="Save As..." />
            </items>
          </Menu>
          <Menu text="_Edit">
            <items>
                  <CheckMenuItem id="gridItem" mnemonicParsing="false" text="Use Gridlines" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem id="copyItem" mnemonicParsing="false" text="Copy" />
                  <Menu id="searchMenu" mnemonicParsing="false" text="Search">
                    <items>
                      <MenuItem id="findItem" mnemonicParsing="false" text="Find" />
                        <MenuItem id="replaceItem" mnemonicParsing="false" text="Replace" />
                    </items>
                  </Menu>
            </items>
          </Menu>
          <Menu text="_Settings">
            <items>
                  <RadioMenuItem id="smallItem" mnemonicParsing="false" text="Small" />
                  <RadioMenuItem id="mediumItem" mnemonicParsing="false" selected="true" text="Medium" />
                  <RadioMenuItem id="largeItem" mnemonicParsing="false" text="Large" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </children>
</AnchorPane>
